model Invoice {
  id                                 String                      @id @default(uuid()) @db.VarChar(36)
  recordId                           String                      @map("record_id") @db.VarChar(36)
  status                             InvoiceStatus               @default(pending)
  healthInsuranceBenefitLevel        HealthInsuranceBenefitLevel @map("health_insurance_benefit_level")
  healthInsuranceRouteType           HealthInsuranceRouteType?   @map("health_insurance_route_type")
  healthInsuranceBenefitRateSnapshot String?                     @map("health_insurance_benefit_rate_snapshot") @db.VarChar(10)
  healthInsuranceRuleSource          String?                     @map("health_insurance_rule_source") @db.VarChar(255)
  subtotal                           Decimal                     @db.Decimal(18, 2)
  healthInsuranceBaseAmount          Decimal                     @default(0) @map("health_insurance_base_amount") @db.Decimal(18, 2)
  healthInsuranceDiscountAmount      Decimal                     @default(0) @map("health_insurance_discount_amount") @db.Decimal(18, 2)
  totalAmount                        Decimal                     @map("total_amount") @db.Decimal(18, 2)
  advanceAppliedAmount               Decimal                     @default(0) @map("advance_applied_amount") @db.Decimal(18, 2)
  amountDue                          Decimal                     @map("amount_due") @db.Decimal(18, 2)
  paymentMethod                      PaymentMethod?              @map("payment_method")
  receiptNumber                      String?                     @unique @map("receipt_number") @db.VarChar(40)
  paidAt                             DateTime?                   @map("paid_at")
  momoOrderId                        String?                     @unique @map("momo_order_id") @db.VarChar(80)
  statementStatus                    String                      @default("draft") @map("statement_status") @db.VarChar(20)
  statementNumber                    String?                     @map("statement_number") @db.VarChar(40)
  statementSignedAt                  DateTime?                   @map("statement_signed_at")
  statementSignedBy                  String?                     @map("statement_signed_by") @db.VarChar(36)
  cancelReason                       String?                     @map("cancel_reason") @db.VarChar(500)
  cancelledAt                        DateTime?                   @map("cancelled_at")
  writeOffReason                     String?                     @map("write_off_reason") @db.VarChar(500)
  writeOffAt                         DateTime?                   @map("write_off_at")
  version                            Int                         @default(1)
  createdAt                          DateTime                    @map("created_at")
  updatedAt                          DateTime                    @map("updated_at")

  medicalRecord    MedicalRecord              @relation(fields: [recordId], references: [id])
  items            InvoiceItem[]
  claim            HealthInsuranceClaim?
  paymentIntents   PaymentIntent[]
  writeOffApproval EmergencyWriteOffApproval?

  @@index([recordId], map: "index_invoice_record")
  @@index([status], map: "index_invoice_status")
  @@map("invoices")
}

model InvoiceItem {
  id                                 String                       @id @default(uuid()) @db.VarChar(36)
  invoiceId                          String                       @map("invoice_id") @db.VarChar(36)
  description                        String                       @db.VarChar(255)
  category                           InvoiceItemCategory
  quantity                           Decimal                      @db.Decimal(12, 2)
  unitPrice                          Decimal                      @map("unit_price") @db.Decimal(18, 2)
  amount                             Decimal                      @db.Decimal(18, 2)
  coveredByHealthInsurance           Boolean                      @default(false) @map("covered_by_health_insurance")
  healthInsuranceBenefitLevel        HealthInsuranceBenefitLevel? @map("health_insurance_benefit_level")
  healthInsuranceBenefitRateSnapshot String?                      @map("health_insurance_benefit_rate_snapshot") @db.VarChar(10)
  healthInsuranceEligibleAmount      Decimal                      @default(0) @map("health_insurance_eligible_amount") @db.Decimal(18, 2)
  healthInsuranceCeilingAmount       Decimal                      @default(0) @map("health_insurance_ceiling_amount") @db.Decimal(18, 2)
  healthInsuranceFundAmount          Decimal                      @default(0) @map("health_insurance_fund_amount") @db.Decimal(18, 2)
  patientCoPayAmount                 Decimal                      @default(0) @map("patient_co_pay_amount") @db.Decimal(18, 2)
  sortOrder                          Int                          @default(0) @map("sort_order")
  createdAt                          DateTime                     @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "index_invoice_item_invoice")
  @@map("invoice_items")
}

model HealthInsuranceClaim {
  id         String                     @id @default(uuid()) @db.VarChar(36)
  invoiceId  String                     @unique @map("invoice_id") @db.VarChar(36)
  status     HealthInsuranceClaimStatus @default(draft)
  voidReason String?                    @map("void_reason") @db.VarChar(100)
  voidedAt   DateTime?                  @map("voided_at")
  createdAt  DateTime                   @map("created_at")
  updatedAt  DateTime                   @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("health_insurance_claims")
}

model PaymentIntent {
  id             String              @id @default(uuid()) @db.VarChar(36)
  invoiceId      String              @map("invoice_id") @db.VarChar(36)
  momoOrderId    String              @unique @map("momo_order_id") @db.VarChar(80)
  requestId      String              @map("request_id") @db.VarChar(120)
  amount         Decimal             @db.Decimal(18, 2)
  status         PaymentIntentStatus @default(pending)
  payUrl         String?             @map("pay_url") @db.VarChar(1000)
  expiresAt      DateTime            @map("expires_at")
  idempotencyKey String              @unique @map("idempotency_key") @db.VarChar(36)
  transId        String?             @map("trans_id") @db.VarChar(80)
  paidAt         DateTime?           @map("paid_at")
  createdAt      DateTime            @map("created_at")
  updatedAt      DateTime            @map("updated_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId], map: "index_payment_intent_invoice")
  @@map("payment_intents")
}

model PaymentIpnLog {
  id             String   @id @default(uuid()) @db.VarChar(36)
  orderId        String?  @map("order_id") @db.VarChar(80)
  transId        String?  @map("trans_id") @db.VarChar(80)
  resultCode     Int?     @map("result_code")
  signatureValid Boolean  @default(false) @map("signature_valid")
  processing     String   @db.VarChar(40)
  rawPayload     Json     @map("raw_payload")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([orderId], map: "index_payment_ipn_order")
  @@index([transId], map: "index_payment_ipn_trans")
  @@map("payment_ipn_logs")
}

model IdempotencyRequest {
  id           String   @id @default(uuid()) @db.VarChar(36)
  key          String   @unique @db.VarChar(36)
  route        String   @db.VarChar(120)
  requestHash  String?  @map("request_hash") @db.VarChar(64)
  statusCode   Int      @map("status_code")
  responseJson Json     @map("response_json")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("idempotency_requests")
}

model PaymentAdvance {
  id            String             @id @default(uuid()) @db.VarChar(36)
  recordId      String             @map("record_id") @db.VarChar(36)
  type          PaymentAdvanceType
  amount        Decimal            @db.Decimal(18, 2)
  method        PaymentMethod
  reason        String?            @db.VarChar(500)
  receiptNumber String?            @unique @map("receipt_number") @db.VarChar(40)
  createdAt     DateTime           @default(now()) @map("created_at")

  medicalRecord MedicalRecord @relation(fields: [recordId], references: [id])

  @@index([recordId], map: "index_payment_advance_record")
  @@map("payment_advances")
}

model EmergencyWriteOffApproval {
  id                     String   @id @default(uuid()) @db.VarChar(36)
  invoiceId              String   @unique @map("invoice_id") @db.VarChar(36)
  recordId               String   @map("record_id") @db.VarChar(36)
  approvedInvoiceVersion Int      @map("approved_invoice_version")
  approvedByUserId       String   @map("approved_by_user_id") @db.VarChar(36)
  writeOffReason         String   @map("write_off_reason") @db.VarChar(500)
  approvedAt             DateTime @map("approved_at")
  createdAt              DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("emergency_write_off_approvals")
}
