generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum QueueTicketStatus {
  waiting
  called
  served
  skipped
}

enum Gender {
  male
  female
}

enum DepartmentType {
  clinical
  paraclinical
  administrative
}

enum BloodType {
  A_PLUS   @map("A+")
  A_MINUS  @map("A-")
  B_PLUS   @map("B+")
  B_MINUS  @map("B-")
  AB_PLUS  @map("AB+")
  AB_MINUS @map("AB-")
  O_PLUS   @map("O+")
  O_MINUS  @map("O-")
}

enum RoomType {
  exam
  lab
  inpatient
  procedure
  storage
  other
}

enum BedStatus {
  available
  occupied
  maintenance
}

enum MedicalRecordStatus {
  open
  waiting_results
  diagnosed
  closed
}

enum ServiceOrderStatus {
  waiting
  completed
  cancelled
}

enum TreatmentType {
  outpatient
  inpatient
}

enum TreatmentOrderType {
  medication
  monitoring
  care
  diet
  procedure
}

enum TreatmentOrderStatus {
  active
  done
  cancelled
}

enum ReleaseReason {
  discharge
  transfer
  correction
}

enum DischargeCondition {
  recovered
  improved
  unchanged
  worse
  deceased
}

enum SignatureMethod {
  dev_e_confirmation
}

enum SpecimenStatus {
  pending
  collected
  handed_over
}

enum LabTestStatus {
  ordered
  in_progress
  resulted
}

enum LabResultTableKey {
  xn_cong_thuc_mau
  xn_nuoc_tieu
  xn_vi_sinh
  xn_mo_benh_hoc
  xn_hoa_sinh_mau
}

enum LabReferenceRangeCondition {
  all
  male
  female
}

enum AttachmentOwnerType {
  medical_record
  lab_test
  prescription
}

enum AttachmentFileType {
  pdf
  png
  jpeg
  xml
}

enum AuditLogAction {
  VIEW
  CREATE
  UPDATE
  DELETE
  LOGIN_SUCCESS
  LOGIN_FAILURE
  RESET_PASSWORD
  SIGN
  PAY
  CANCEL
  EXPORT
  OVERRIDE
  SYNC
  WRITE_OFF
  DISPENSE
}

enum PrescriptionStatus {
  draft
  active
  xml_exported
  cancelled
}

enum PrescriptionType {
  C
  N
  H
}

enum InvoiceStatus {
  pending
  paid
  cancelled
  write_off
}

enum HealthInsuranceBenefitLevel {
  NO_COVERAGE
  RATE_80
  RATE_95
  RATE_100
}

enum HealthInsuranceRouteType {
  right_route
  referral
  emergency
  wrong_route
}

enum HealthInsuranceClaimStatus {
  draft
  exported_xml
  voided
}

enum PaymentMethod {
  cash
  momo
}

enum PaymentIntentStatus {
  pending
  paid
  expired
  failed
}

enum PaymentAdvanceType {
  deposit
  refund
}

enum StockMovementType {
  receipt
  prescription_sign
  prescription_cancel
  adjustment
}

enum InvoiceItemCategory {
  consultation
  lab
  medicine
  bed
  procedure
  other
}

enum medical_records_skinLesionDistribution {
  localized
  scattered
  generalized
  symmetric
  dermatomal
  flexural
}

enum medical_records_itchSeverity {
  none
  mild
  moderate
  severe
}

enum medical_records_icdCodingSystem {
  TT06_2026
}

enum medical_records_diagnosisSignatureMethod {
  dev_e_confirmation
}

enum medical_records_closeSignatureMethod {
  dev_e_confirmation
}

model User {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  username           String    @unique @db.VarChar(50)
  password           String    @db.VarChar(255)
  fullName           String    @db.VarChar(255)
  gender             Gender
  dateOfBirth        DateTime  @db.Date
  phoneNumber        String    @db.VarChar(10)
  identityCardNumber String    @unique @db.VarChar(12)
  departmentId       String    @db.VarChar(36)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(true)
  authVersion        Int       @default(1)
  lastLoginAt        DateTime? @db.DateTime(3)
  createdAt          DateTime  @default(now()) @db.DateTime(3)
  updatedAt          DateTime  @updatedAt @db.DateTime(3)

  department                        Department         @relation(fields: [departmentId], references: [id])
  permissions                       Permission[]
  medicalRecordsAsDoctor            MedicalRecord[]    @relation("DoctorMedicalRecords")
  medicalRecordsAsDiagnosedBy       MedicalRecord[]    @relation("DiagnosedByRecords")
  medicalRecordsAsDiagnosisSignedBy MedicalRecord[]    @relation("DiagnosisSignedByRecords")
  medicalRecordsAsVitalConfirmedBy  MedicalRecord[]    @relation("VitalConfirmedByRecords")
  medicalRecordsAsClosedBy          MedicalRecord[]    @relation("ClosedByRecords")
  bedAssignmentsAsAssignedBy        BedAssignment[]    @relation("AssignedByBedAssignments")
  bedAssignmentsAsReleasedBy        BedAssignment[]    @relation("ReleasedByBedAssignments")
  treatmentOrdersAsOrderedBy        TreatmentOrder[]   @relation("OrderedByTreatmentOrders")
  treatmentOrdersAsExecutedBy       TreatmentOrder[]   @relation("ExecutedByTreatmentOrders")
  treatmentOrdersAsCancelledBy      TreatmentOrder[]   @relation("CancelledByTreatmentOrders")
  dischargeSummariesAsSignedBy      DischargeSummary[] @relation("SignedByDischargeSummaries")
  labTestsAsOrderedBy               LabTest[]          @relation("OrderedByLabTests")
  labTestsAsResultedBy              LabTest[]          @relation("ResultedByLabTests")
  labTestsAsSignedBy                LabTest[]          @relation("SignedByLabTests")
  attachmentsUploaded               Attachment[]       @relation("UploadedAttachments")
  pathologyResultsAsDoctor          XnMoBenhHoc[]      @relation("PathologyDoctor")
  prescriptionsAsPrescribedBy       Prescription[]     @relation("PrescribedByPrescriptions")
  prescriptionsAsSignedBy           Prescription[]     @relation("SignedByPrescriptions")
  prescriptionsAsCancelledBy        Prescription[]     @relation("CancelledByPrescriptions")
  prescriptionsAsDispensedBy        Prescription[]     @relation("DispensedByPrescriptions")

  @@index([departmentId])
  @@index([isActive])
  @@index([fullName])
  @@map("users")
}

model Role {
  id              String           @id @default(uuid()) @db.VarChar(36)
  code            String           @unique @db.VarChar(30)
  name            String           @db.VarChar(100)
  description     String?          @db.VarChar(255)
  isSystem        Boolean          @default(true)
  isPrivileged    Boolean          @default(false)
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)
  permissions     Permission[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id         String   @id @default(uuid()) @db.VarChar(36)
  userId     String   @db.VarChar(36)
  roleCode   String   @db.VarChar(30)
  assignedAt DateTime @default(now()) @db.DateTime(3)
  assignedBy String?  @db.VarChar(36)

  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade, onUpdate: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@unique([userId, roleCode])
  @@index([roleCode])
  @@map("permissions")
}

model RolePermission {
  roleCode   String   @db.VarChar(30)
  actionCode String   @db.VarChar(80)
  createdAt  DateTime @default(now()) @db.DateTime(3)

  role Role @relation(fields: [roleCode], references: [code], onDelete: Cascade, onUpdate: Cascade)

  @@id([roleCode, actionCode])
  @@map("role_permissions")
}

model RbacPolicyVersion {
  revision  String   @id @db.VarChar(40)
  checksum  String   @db.VarChar(64)
  appliedAt DateTime @default(now()) @db.DateTime(3)

  @@map("rbac_policy_versions")
}

model QueueTicket {
  id        String            @id @default(uuid()) @db.VarChar(36)
  number    Int
  date      DateTime          @default(dbgenerated("(curdate())")) @db.Date
  status    QueueTicketStatus @default(waiting)
  calledAt  DateTime?
  servedAt  DateTime?
  recordId  String?           @unique @db.VarChar(36)
  createdAt DateTime          @default(now())

  medicalRecord MedicalRecord? @relation(fields: [recordId], references: [id])

  @@unique([date, number], map: "unique_key_queue_ticket_date_number")
  @@map("queue_tickets")
}

model QueueDailySequence {
  date       DateTime @id @db.Date
  lastNumber Int      @default(0) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("queue_daily_sequences")
}

model Patient {
  id                                 String     @id @default(uuid()) @db.VarChar(36)
  patientCode                        String     @unique @db.VarChar(20)
  fullName                           String     @db.VarChar(255)
  dateOfBirth                        DateTime   @db.Date
  gender                             Gender
  phoneNumber                        String?    @db.VarChar(15)
  phoneNumberUnavailableReason       String?    @db.VarChar(500)
  identityCardNumber                 String?    @unique @db.VarChar(12)
  address                            String?    @db.VarChar(500)
  province                           String?    @db.VarChar(100)
  ward                               String?    @db.VarChar(100)
  bloodType                          BloodType?
  allergies                          String?    @db.Text
  healthInsuranceCode                String?    @db.VarChar(20)
  healthInsuranceExpiryDate          DateTime?  @db.Date
  healthInsuranceInitialFacilityCode String?    @db.VarChar(10)
  healthInsuranceBenefitRateHint     Decimal?   @db.Decimal(5, 4)
  emergencyContact                   String?    @db.VarChar(255)
  emergencyPhoneNumber               String?    @db.VarChar(15)
  guardianFullName                   String?    @db.VarChar(255)
  guardianPhoneNumber                String?    @db.VarChar(15)
  isEmergencyBypass                  Boolean    @default(false)
  emergencyReason                    String?    @db.VarChar(500)
  privacyNoticeAccepted              Boolean    @default(false)
  privacyNoticeAcceptedAt            DateTime?
  deletedAt                          DateTime?
  version                            Int        @default(1)
  createdAt                          DateTime   @default(now())
  updatedAt                          DateTime   @updatedAt

  beds           Bed[]
  medicalRecords MedicalRecord[]

  @@index([fullName], map: "index_patient_full_name")
  @@index([phoneNumber], map: "index_patient_phone")
  @@index([deletedAt])
  @@index([province])
  @@map("patients")
}

model Doctor {
  id           String   @id @default(uuid()) @db.VarChar(36)
  fullName     String   @db.VarChar(255)
  employeeCode String   @unique @db.VarChar(50)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@map("doctors")
}

model Department {
  id        String         @id @default(uuid()) @db.VarChar(36)
  code      String         @unique @db.VarChar(20)
  name      String         @db.VarChar(255)
  type      DepartmentType @default(clinical)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  users          User[]
  rooms          Room[]
  labTestTypes   LabTestType[]
  medicalRecords MedicalRecord[]
  serviceCatalog ServiceCatalog[]

  @@map("departments")
}

model ServiceCatalog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  code         String   @unique @db.VarChar(30)
  name         String   @db.VarChar(255)
  price        Decimal  @db.Decimal(15, 2)
  isActive     Boolean  @default(true)
  departmentId String?  @db.VarChar(36)
  createdAt    DateTime @default(now())

  department    Department?    @relation(fields: [departmentId], references: [id])
  serviceOrders ServiceOrder[]

  @@map("service_catalog")
}

model MedicalRecord {
  id                       String                                    @id @default(uuid()) @db.VarChar(36)
  recordCode               String                                    @unique @db.VarChar(20)
  patientId                String                                    @db.VarChar(36)
  doctorId                 String                                    @db.VarChar(36)
  departmentId             String?                                   @db.VarChar(36)
  status                   MedicalRecordStatus                       @default(open)
  isEmergency              Boolean                                   @default(false)
  emergencyReason          String?                                   @db.VarChar(500)
  chiefComplaint           String?                                   @db.VarChar(500)
  vitalSigns               Json?
  heightCm                 Decimal?                                  @db.Decimal(5, 1)
  weightKg                 Decimal?                                  @db.Decimal(5, 1)
  historyOfPresentIllness  String?                                   @db.Text
  pastMedicalHistory       String?                                   @db.Text
  familyHistory            String?                                   @db.Text
  skinLesionTypes          String?                                   @db.VarChar(255)
  skinLesionDescription    String?                                   @db.Text
  skinLesionLocation       String?                                   @db.VarChar(500)
  skinLesionDistribution   medical_records_skinLesionDistribution?
  bodySurfaceAreaPercent   Decimal?                                  @db.Decimal(5, 2)
  itchSeverity             medical_records_itchSeverity?
  vitalConfirmedBy         String?                                   @db.VarChar(36)
  vitalConfirmedAt         DateTime?
  icd10                    String?                                   @db.VarChar(10)
  icdCodingSystem          medical_records_icdCodingSystem?
  diagnosisText            String?                                   @db.VarChar(1000)
  diagnosedBy              String?                                   @db.VarChar(36)
  diagnosedAt              DateTime?
  diagnosisSignedBy        String?                                   @db.VarChar(36)
  diagnosisSignedAt        DateTime?
  diagnosisSignatureMethod medical_records_diagnosisSignatureMethod?
  treatmentType            TreatmentType                             @default(outpatient)
  bedId                    String?                                   @db.VarChar(36)
  notes                    String?                                   @db.Text
  closedAt                 DateTime?
  closedBy                 String?                                   @db.VarChar(36)
  closeSignatureMethod     medical_records_closeSignatureMethod?
  deletedAt                DateTime?
  version                  Int                                       @default(1)
  createdAt                DateTime                                  @default(now())
  updatedAt                DateTime                                  @updatedAt

  patient               Patient           @relation(fields: [patientId], references: [id])
  doctor                User              @relation("DoctorMedicalRecords", fields: [doctorId], references: [id])
  department            Department?       @relation(fields: [departmentId], references: [id])
  bed                   Bed?              @relation(fields: [bedId], references: [id])
  diagnosedByUser       User?             @relation("DiagnosedByRecords", fields: [diagnosedBy], references: [id])
  diagnosisSignedByUser User?             @relation("DiagnosisSignedByRecords", fields: [diagnosisSignedBy], references: [id])
  vitalConfirmedByUser  User?             @relation("VitalConfirmedByRecords", fields: [vitalConfirmedBy], references: [id])
  closedByUser          User?             @relation("ClosedByRecords", fields: [closedBy], references: [id])
  serviceOrders         ServiceOrder[]
  queueTicket           QueueTicket?
  invoices              Invoice[]
  paymentAdvances       PaymentAdvance[]
  labTests              LabTest[]
  prescriptions         Prescription[]
  bedAssignments        BedAssignment[]
  treatmentOrders       TreatmentOrder[]
  dischargeSummary      DischargeSummary?
  vitalSignLogs         VitalSignLog[]

  @@index([patientId], map: "index_medical_record_patient")
  @@index([doctorId], map: "index_medical_record_doctor")
  @@index([status], map: "index_medical_record_status")
  @@index([deletedAt])
  @@index([bedId])
  @@map("medical_records")
}

model ServiceOrder {
  id               String             @id @default(uuid()) @db.VarChar(36)
  recordId         String             @db.VarChar(36)
  serviceCatalogId String             @db.VarChar(36)
  fee              Decimal            @db.Decimal(15, 2)
  status           ServiceOrderStatus @default(waiting)
  createdAt        DateTime           @default(now())

  record         MedicalRecord  @relation(fields: [recordId], references: [id])
  serviceCatalog ServiceCatalog @relation(fields: [serviceCatalogId], references: [id])

  @@index([recordId], map: "index_service_order_record")
  @@map("service_orders")
}

model CodeSequence {
  key        String @id @db.VarChar(30)
  lastNumber Int    @default(0) @map("last_number")

  @@map("code_sequences")
}

model Room {
  id           String   @id @default(uuid()) @db.VarChar(36)
  code         String   @unique @db.VarChar(50)
  name         String?  @db.VarChar(255)
  departmentId String?  @db.VarChar(36)
  roomType     RoomType @default(other)
  floor        String?  @db.VarChar(20)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  department Department? @relation(fields: [departmentId], references: [id])
  beds       Bed[]

  @@index([departmentId])
  @@index([isActive])
  @@map("rooms")
}

model Bed {
  id         String    @id @default(uuid()) @db.VarChar(36)
  roomId     String    @db.VarChar(36)
  number     String    @db.VarChar(20)
  dailyRate  Decimal   @default(200000.00) @db.Decimal(15, 2)
  status     BedStatus @default(available)
  patientId  String?   @db.VarChar(36)
  assignedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  room           Room            @relation(fields: [roomId], references: [id])
  patient        Patient?        @relation(fields: [patientId], references: [id])
  bedAssignments BedAssignment[]
  medicalRecords MedicalRecord[]

  @@unique([roomId, number], map: "unique_key_bed_room_number")
  @@index([patientId])
  @@index([roomId])
  @@index([status])
  @@map("beds")
}

model BedAssignment {
  id                String         @id @default(uuid()) @db.VarChar(36)
  recordId          String         @db.VarChar(36)
  bedId             String         @db.VarChar(36)
  dailyRateSnapshot Decimal        @db.Decimal(15, 2)
  assignedBy        String         @db.VarChar(36)
  assignedAt        DateTime       @default(now())
  releasedBy        String?        @db.VarChar(36)
  releasedAt        DateTime?
  releaseReason     ReleaseReason?
  note              String?        @db.VarChar(255)
  openRecordSlot    String?        @unique @db.VarChar(36)
  openBedSlot       String?        @unique @db.VarChar(36)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  assignedByUser User          @relation("AssignedByBedAssignments", fields: [assignedBy], references: [id])
  releasedByUser User?         @relation("ReleasedByBedAssignments", fields: [releasedBy], references: [id])
  record         MedicalRecord @relation(fields: [recordId], references: [id])
  bed            Bed           @relation(fields: [bedId], references: [id])

  @@index([assignedBy])
  @@index([releasedBy])
  @@index([bedId, assignedAt])
  @@index([recordId, assignedAt])
  @@map("bed_assignments")
}

model TreatmentOrder {
  id           String               @id @default(uuid()) @db.VarChar(36)
  recordId     String               @db.VarChar(36)
  orderedBy    String               @db.VarChar(36)
  orderType    TreatmentOrderType
  content      String               @db.VarChar(1000)
  orderedAt    DateTime             @default(now())
  status       TreatmentOrderStatus @default(active)
  executedBy   String?              @db.VarChar(36)
  executedAt   DateTime?
  cancelReason String?              @db.VarChar(500)
  cancelledBy  String?              @db.VarChar(36)
  cancelledAt  DateTime?
  note         String?              @db.VarChar(500)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  record          MedicalRecord @relation(fields: [recordId], references: [id])
  orderedByUser   User          @relation("OrderedByTreatmentOrders", fields: [orderedBy], references: [id])
  executedByUser  User?         @relation("ExecutedByTreatmentOrders", fields: [executedBy], references: [id])
  cancelledByUser User?         @relation("CancelledByTreatmentOrders", fields: [cancelledBy], references: [id])

  @@index([recordId])
  @@index([orderedBy])
  @@index([status])
  @@map("treatment_orders")
}

model DischargeSummary {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  recordId           String             @unique @db.VarChar(36)
  dischargeDiagnosis String             @db.VarChar(1000)
  icd10              String?            @db.VarChar(10)
  treatmentSummary   String             @db.Text
  dischargeCondition DischargeCondition
  doctorAdvice       String?            @db.Text
  followUpDate       DateTime?          @db.Date
  signedBy           String             @db.VarChar(36)
  signedAt           DateTime           @default(now())
  signatureMethod    SignatureMethod    @default(dev_e_confirmation)
  dischargedAt       DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  record       MedicalRecord @relation(fields: [recordId], references: [id])
  signedByUser User          @relation("SignedByDischargeSummaries", fields: [signedBy], references: [id])

  @@index([signedBy])
  @@map("discharge_summaries")
}

model SpecimenCollection {
  id               String         @id @default(uuid()) @db.VarChar(36)
  recordId         String         @db.VarChar(36)
  patientCode      String         @db.VarChar(20)
  patientName      String         @db.VarChar(255)
  departmentName   String         @db.VarChar(255)
  specimenCode     String         @unique @db.VarChar(50)
  specimenType     String         @db.VarChar(100)
  orderDescription String         @db.VarChar(1000)
  priority         Boolean        @default(false)
  status           SpecimenStatus @default(pending)
  barcodePrinted   Boolean        @default(false)
  collectedBy      String?        @db.VarChar(36)
  collectedAt      DateTime?
  handedOverBy     String?        @db.VarChar(36)
  handedOverAt     DateTime?
  labReceiverName  String?        @db.VarChar(255)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@map("specimen_collections")
}

model LabTestType {
  id             String            @id @default(uuid()) @db.VarChar(36)
  code           String            @unique @db.VarChar(30)
  name           String            @db.VarChar(255)
  category       String?           @db.VarChar(100)
  departmentId   String            @db.VarChar(36)
  resultTableKey LabResultTableKey
  specimen       String?           @db.VarChar(100)
  resultUnit     String?           @db.VarChar(50)
  method         String?           @db.VarChar(255)
  referenceRange String?           @db.VarChar(255)
  price          Decimal           @default(0) @db.Decimal(15, 2)
  isActive       Boolean           @default(true)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  department      Department          @relation(fields: [departmentId], references: [id])
  labTests        LabTest[]
  referenceRanges LabReferenceRange[]

  @@index([departmentId])
  @@index([isActive])
  @@map("lab_test_types")
}

model LabReferenceRange {
  id            String                     @id @default(uuid()) @db.VarChar(36)
  labTestTypeId String                     @db.VarChar(36)
  fieldKey      String                     @db.VarChar(100)
  code          String                     @db.VarChar(20)
  label         String                     @db.VarChar(255)
  unit          String?                    @db.VarChar(50)
  lowerBound    Decimal?                   @db.Decimal(15, 4)
  upperBound    Decimal?                   @db.Decimal(15, 4)
  condition     LabReferenceRangeCondition @default(all)
  isActive      Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  labTestType LabTestType @relation(fields: [labTestTypeId], references: [id])

  @@index([labTestTypeId, isActive])
  @@index([code])
  @@map("lab_reference_ranges")
}

model LabTest {
  id                 String           @id @default(uuid()) @db.VarChar(36)
  recordId           String           @db.VarChar(36)
  labTestTypeId      String           @db.VarChar(36)
  testName           String           @db.VarChar(255)
  fee                Decimal          @default(0) @db.Decimal(15, 2)
  status             LabTestStatus    @default(ordered)
  isUrgent           Boolean          @default(false)
  orderedBy          String           @db.VarChar(36)
  orderedAt          DateTime         @default(now())
  specimenType       String?          @db.VarChar(100)
  specimenReceivedAt DateTime?
  method             String?          @db.VarChar(255)
  conclusion         String?          @db.VarChar(1000)
  reportCode         String?          @db.VarChar(30)
  resultedBy         String?          @db.VarChar(36)
  resultedAt         DateTime?
  signedBy           String?          @db.VarChar(36)
  signedAt           DateTime?
  signatureMethod    SignatureMethod?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  medicalRecord    MedicalRecord  @relation(fields: [recordId], references: [id])
  labTestType      LabTestType    @relation(fields: [labTestTypeId], references: [id])
  orderedByUser    User           @relation("OrderedByLabTests", fields: [orderedBy], references: [id])
  resultedByUser   User?          @relation("ResultedByLabTests", fields: [resultedBy], references: [id])
  signedByUser     User?          @relation("SignedByLabTests", fields: [signedBy], references: [id])
  cbcResult        XnCongThucMau?
  urinalysisResult XnNuocTieu?
  microbiology     XnViSinh?
  pathology        XnMoBenhHoc?
  bioChemistry     XnHoaSinhMau?

  @@index([recordId])
  @@index([labTestTypeId])
  @@index([status])
  @@index([orderedAt])
  @@map("lab_tests")
}

model Attachment {
  id             String              @id @default(uuid()) @db.VarChar(36)
  ownerType      AttachmentOwnerType
  ownerId        String              @db.VarChar(36)
  filePath       String              @db.VarChar(1000)
  fileType       AttachmentFileType
  originalName   String              @db.VarChar(255)
  mimeType       String              @db.VarChar(100)
  sizeBytes      BigInt              @db.UnsignedBigInt
  checksumSha256 String              @db.Char(64)
  uploadedBy     String              @db.VarChar(36)
  uploadedAt     DateTime            @default(now())

  uploadedByUser User @relation("UploadedAttachments", fields: [uploadedBy], references: [id])

  @@index([ownerType, ownerId])
  @@index([uploadedBy])
  @@index([checksumSha256])
  @@map("attachments")
}

model AuditLog {
  id         String         @id @default(uuid()) @db.VarChar(36)
  userId     String?        @db.VarChar(36)
  userRole   String         @default("public") @db.VarChar(30)
  userName   String         @default("") @db.VarChar(255)
  action     AuditLogAction
  resource   String         @db.VarChar(50)
  resourceId String?        @db.VarChar(36)
  metadata   Json?
  createdAt  DateTime       @default(now())

  @@index([createdAt])
  @@index([resource, resourceId])
  @@index([userId, createdAt])
  @@map("audit_logs")
}

model Medicine {
  id                       String   @id @default(uuid()) @db.VarChar(36)
  code                     String?  @unique @db.VarChar(30)
  name                     String   @db.VarChar(255)
  activeIngredient         String?  @db.VarChar(255)
  dosage                   String?  @db.VarChar(100)
  unit                     String   @db.VarChar(50)
  unitPrice                Decimal  @db.Decimal(15, 2)
  coveredByHealthInsurance Boolean  @default(false)
  isActive                 Boolean  @default(true)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  medicineBatches   MedicineBatch[]
  prescriptionItems PrescriptionItem[]
  stockMovements    StockMovement[]

  @@index([name])
  @@index([activeIngredient])
  @@index([isActive])
  @@map("medicines")
}

model PharmacyWarehouse {
  id        String   @id @default(uuid()) @db.VarChar(36)
  code      String   @unique @db.VarChar(30)
  name      String   @db.VarChar(255)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  medicineBatches MedicineBatch[]
  stockMovements  StockMovement[]

  @@index([isActive])
  @@map("pharmacy_warehouses")
}

model MedicineBatch {
  id          String   @id @default(uuid()) @db.VarChar(36)
  warehouseId String   @db.VarChar(36)
  medicineId  String   @db.VarChar(36)
  batchNumber String   @db.VarChar(100)
  expiryDate  DateTime @db.Date
  quantity    Int      @default(0)
  importPrice Decimal  @default(0) @db.Decimal(15, 2)
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  warehouse      PharmacyWarehouse @relation(fields: [warehouseId], references: [id])
  medicine       Medicine          @relation(fields: [medicineId], references: [id])
  stockMovements StockMovement[]

  @@unique([warehouseId, medicineId, batchNumber])
  @@index([medicineId, expiryDate])
  @@index([warehouseId, medicineId, expiryDate])
  @@index([isActive])
  @@map("medicine_batches")
}

model Prescription {
  id                    String             @id @default(uuid()) @db.VarChar(36)
  recordId              String             @db.VarChar(36)
  prescriptionCode      String             @unique @db.VarChar(40)
  prescribedBy          String             @db.VarChar(36)
  roundNumber           Int
  prescriptionType      PrescriptionType
  status                PrescriptionStatus @default(draft)
  isSigned              Boolean            @default(false)
  signedBy              String?            @db.VarChar(36)
  signedAt              DateTime?
  signatureMethod       SignatureMethod?
  allergyOverrideReason String?            @db.VarChar(500)
  allergyOverrideBy     String?            @db.VarChar(36)
  allergyOverrideAt     DateTime?
  xmlExportedAt         DateTime?
  xmlFilePath           String?            @db.VarChar(1000)
  cancelledBy           String?            @db.VarChar(36)
  cancelledAt           DateTime?
  cancelReason          String?            @db.VarChar(500)
  dispensedBy           String?            @db.VarChar(36)
  dispensedAt           DateTime?
  version               Int                @default(1)
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt

  medicalRecord     MedicalRecord      @relation(fields: [recordId], references: [id])
  prescribedByUser  User               @relation("PrescribedByPrescriptions", fields: [prescribedBy], references: [id])
  signedByUser      User?              @relation("SignedByPrescriptions", fields: [signedBy], references: [id])
  cancelledByUser   User?              @relation("CancelledByPrescriptions", fields: [cancelledBy], references: [id])
  dispensedByUser   User?              @relation("DispensedByPrescriptions", fields: [dispensedBy], references: [id])
  prescriptionItems PrescriptionItem[]
  stockMovements    StockMovement[]

  @@index([recordId])
  @@index([status])
  @@index([createdAt])
  @@map("prescriptions")
}

model PrescriptionItem {
  id                       String   @id @default(uuid()) @db.VarChar(36)
  prescriptionId           String   @db.VarChar(36)
  medicineId               String?  @db.VarChar(36)
  medicineNameSnapshot     String?  @db.VarChar(255)
  activeIngredientSnapshot String?  @db.VarChar(255)
  dosageSnapshot           String?  @db.VarChar(100)
  quantity                 Int
  days                     Int
  dosePerUse               String?  @db.VarChar(50)
  usesPerDay               Int?
  useTiming                String?  @db.VarChar(100)
  dosageInstruction        String   @db.VarChar(500)
  longTermReason           String?  @db.VarChar(500)
  unitPrice                Decimal  @db.Decimal(15, 2)
  total                    Decimal  @db.Decimal(15, 2)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  prescription   Prescription    @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicine       Medicine?       @relation(fields: [medicineId], references: [id])
  stockMovements StockMovement[]

  @@index([prescriptionId])
  @@index([medicineId])
  @@map("prescription_items")
}

model StockMovement {
  id                 String            @id @default(uuid()) @db.VarChar(36)
  warehouseId        String            @db.VarChar(36)
  medicineId         String            @db.VarChar(36)
  batchId            String            @db.VarChar(36)
  prescriptionId     String?           @db.VarChar(36)
  prescriptionItemId String?           @db.VarChar(36)
  quantityChange     Int
  balanceAfter       Int
  movementType       StockMovementType
  actorUserId        String?           @db.VarChar(36)
  referenceType      String?           @db.VarChar(60)
  referenceId        String?           @db.VarChar(36)
  idempotencyKey     String?           @db.VarChar(36)
  createdAt          DateTime          @default(now())

  warehouse        PharmacyWarehouse @relation(fields: [warehouseId], references: [id])
  medicine         Medicine          @relation(fields: [medicineId], references: [id])
  batch            MedicineBatch     @relation(fields: [batchId], references: [id])
  prescription     Prescription?     @relation(fields: [prescriptionId], references: [id], onDelete: SetNull)
  prescriptionItem PrescriptionItem? @relation(fields: [prescriptionItemId], references: [id], onDelete: SetNull)

  @@index([warehouseId, createdAt])
  @@index([medicineId, createdAt])
  @@index([batchId, createdAt])
  @@index([prescriptionId])
  @@index([movementType, createdAt])
  @@map("stock_movements")
}

model VitalSignLog {
  id                     String   @id @default(uuid()) @db.VarChar(36)
  recordId               String   @db.VarChar(36)
  treatmentOrderId       String?  @db.VarChar(36)
  measuredAt             DateTime @default(now())
  pulse                  Int?
  temperatureC           Decimal? @db.Decimal(4, 1)
  bloodPressureSystolic  Int?
  bloodPressureDiastolic Int?
  respiratoryRate        Int?
  spo2                   Int?
  weightKg               Decimal? @db.Decimal(5, 1)
  note                   String?  @db.VarChar(500)
  recordedBy             String?  @db.VarChar(36)
  createdAt              DateTime @default(now())

  medicalRecord MedicalRecord @relation(fields: [recordId], references: [id])

  @@index([recordId, measuredAt])
  @@map("vital_sign_logs")
}

