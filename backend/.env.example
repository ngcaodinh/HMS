NODE_ENV=development
PORT=4000
HOST=0.0.0.0
APP_TIMEZONE=Asia/Ho_Chi_Minh

DATABASE_URL=mysql://hms_user:hms_password@localhost:3306/hms_vn

JWT_SECRET=change_me_in_local_env
JWT_EXPIRES_IN=8h
JWT_REMEMBER_EXPIRES_IN=30d
JWT_ISSUER=hms-vn
JWT_AUDIENCE=hms-vn-staff
IT_DEV_PASSWORD=change_me_for_local_seed
ADMIN_DEV_PASSWORD=change_me_for_local_seed

CORS_ORIGINS=http://localhost:3000
UPLOAD_ROOT=./uploads

USE_MOMO_MOCK=false
MOMO_ENDPOINT=https://test-payment.momo.vn
MOMO_ENV=test
MOMO_PARTNER_CODE=change_me_momo_partner_code
MOMO_ACCESS_KEY=change_me_momo_access_key
MOMO_SECRET_KEY=change_me_momo_secret_key
MOMO_RETURN_URL=http://localhost:3000/accounting?momo=return
MOMO_IPN_URL=http://localhost:4000/api/v1/webhooks/momo
MOMO_REQUEST_TYPE=payWithMethod
SENTRY_DSN=

# Gợi ý: copy sang .env và điền credential MySQL thật.
# Queue public (kiosk/LED) không cần JWT.
# Staff queue: development BE tự gán principal receptionist (stub đến khi Auth lane sẵn sàng).
